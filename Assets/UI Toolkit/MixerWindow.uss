.screen {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    left: 0;
    align-items: center;
    justify-content: center;
}

.window {
    width: 780px;
    background-color: rgb(26, 27, 30);
    border-width: 1px;
    border-color: rgb(58, 60, 66);
    border-radius: 14px;
    padding-bottom: 14px;
}

.titlebar {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding: 12px 16px;
    background-color: rgb(33, 35, 39);
    border-top-left-radius: 14px;
    border-top-right-radius: 14px;
    border-bottom-width: 1px;
    border-bottom-color: rgb(58, 60, 66);
}

.titlebar__title {
    color: rgb(236, 238, 242);
    font-size: 20px;
    -unity-font-style: bold;
}

.titlebar__close {
    width: 28px;
    height: 28px;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    color: rgb(150, 154, 162);
    font-size: 16px;
}

.titlebar__close:hover {
    background-color: rgb(120, 52, 52);
    color: rgb(245, 245, 245);
    border-radius: 6px;
}

.body {
    flex-direction: row;
    padding: 16px;
}

.bench {
    flex-grow: 1;
}

.output {
    width: 168px;
    margin-left: 16px;
    padding-left: 16px;
    border-left-width: 1px;
    border-left-color: rgb(46, 48, 54);
    align-items: center;
}

.caption {
    color: rgb(132, 137, 147);
    font-size: 12px;
    -unity-font-style: bold;
    margin-bottom: 6px;
}

.caption--shelf {
    margin-left: 16px;
}

.slot-row {
    flex-direction: row;
    margin-bottom: 14px;
}

.slot-grid {
    flex-direction: row;
    flex-wrap: wrap;
}

.slot {
    width: 58px;
    height: 58px;
    margin-right: 6px;
    margin-bottom: 6px;
    background-color: rgb(20, 21, 24);
    border-width: 2px;
    border-color: rgb(54, 56, 62);
    border-radius: 8px;
    align-items: center;
    justify-content: center;
}

.slot:hover {
    border-color: rgb(84, 88, 96);
}

.slot--main {
    width: 68px;
    height: 68px;
}

.slot--result {
    width: 76px;
    height: 76px;
    margin-right: 0;
    border-color: rgb(70, 74, 82);
}

.slot--accept {
    border-color: rgb(214, 173, 70);
    background-color: rgb(38, 33, 20);
}

.slot--reject {
    opacity: 0.4;
}

.slot__icon {
    width: 40px;
    height: 40px;
}

.slot__count {
    position: absolute;
    right: 4px;
    bottom: 2px;
    color: rgb(236, 238, 242);
    font-size: 13px;
    -unity-font-style: bold;
}

.timer {
    color: rgb(214, 173, 70);
    font-size: 15px;
    -unity-font-style: bold;
    height: 22px;
    margin-top: 8px;
    margin-bottom: 8px;
}

.button {
    width: 136px;
    height: 34px;
    margin-top: 6px;
    background-color: rgb(46, 49, 56);
    border-width: 0;
    border-radius: 8px;
    color: rgb(226, 229, 235);
    font-size: 14px;
}

.button:hover {
    background-color: rgb(60, 64, 73);
}

.button:disabled {
    opacity: 0.35;
}

.button--primary {
    background-color: rgb(176, 138, 46);
    color: rgb(24, 20, 10);
    -unity-font-style: bold;
}

.button--primary:hover {
    background-color: rgb(206, 165, 62);
}

.shelf {
    height: 128px;
    margin: 0 16px;
    background-color: rgb(20, 21, 24);
    border-width: 1px;
    border-color: rgb(46, 48, 54);
    border-radius: 10px;
}

.shelf__items {
    flex-direction: row;
    flex-wrap: wrap;
    padding: 8px;
}

.card {
    width: 84px;
    margin: 4px;
    padding: 6px;
    background-color: rgb(34, 36, 41);
    border-width: 1px;
    border-color: rgb(52, 55, 61);
    border-radius: 8px;
    align-items: center;
}

.card:hover {
    background-color: rgb(44, 47, 54);
    border-color: rgb(214, 173, 70);
}

.card__icon {
    width: 40px;
    height: 40px;
}

.card__name {
    color: rgb(206, 210, 217);
    font-size: 11px;
    -unity-text-align: middle-center;
    white-space: normal;
}

.card__amount {
    position: absolute;
    top: 2px;
    right: 6px;
    color: rgb(214, 173, 70);
    font-size: 12px;
    -unity-font-style: bold;
}

.ghost {
    position: absolute;
    width: 48px;
    height: 48px;
    opacity: 0.85;
}
