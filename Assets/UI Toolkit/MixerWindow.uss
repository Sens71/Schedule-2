.caption {
    color: rgb(132, 137, 147);
    font-size: 12px;
    -unity-font-style: bold;
    margin-bottom: 6px;
}

.button {
    width: 136px;
    height: 34px;
    margin-top: 6px;
    background-color: rgb(46, 49, 56);
    border-width: 0;
    border-radius: 8px;
    color: rgb(226, 229, 235);
    font-size: 14px;
}

.button:hover {
    background-color: rgb(60, 64, 73);
}

.button:disabled {
    opacity: 0.35;
}

.button--primary {
    background-color: rgb(176, 138, 46);
    color: rgb(24, 20, 10);
    -unity-font-style: bold;
}

.button--primary:hover {
    background-color: rgb(206, 165, 62);
}

.card:hover {
    background-color: rgb(44, 47, 54);
    border-color: rgb(214, 173, 70);
}

.slot--accept {
    border-color: rgb(214, 173, 70);
    background-color: rgb(38, 33, 20);
}

.slot--reject {
    opacity: 0.4;
}
