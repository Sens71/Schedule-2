<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI%20Toolkit/Common.uss?fileID=7433441132597879392&amp;guid=2c0e2631ab82f304f97019221b78c4e1&amp;type=3#Common" />
    <ui:VisualElement name="Card" class="card" style="width: 150px; margin-top: 4px; margin-right: 4px; margin-bottom: 4px; margin-left: 4px; padding-top: 6px; padding-right: 6px; padding-bottom: 6px; padding-left: 6px; background-color: rgb(34, 36, 41); border-top-width: 8px; border-right-width: 8px; border-bottom-width: 8px; border-left-width: 8px; border-top-color: rgb(229, 229, 229); border-right-color: rgb(229, 229, 229); border-bottom-color: rgb(229, 229, 229); border-left-color: rgb(229, 229, 229); border-top-left-radius: 23px; border-top-right-radius: 23px; border-bottom-right-radius: 23px; border-bottom-left-radius: 23px; align-items: center; height: 150px;">
        <ui:VisualElement name="Icon" picking-mode="Ignore" style="width: 90px; height: 90px; background-image: url(&quot;project://database/Assets/Textures/Icons/Donut_Icon.png?fileID=2800000&amp;guid=87d5c75e45c124a4f9716a978714ad4c&amp;type=3#Donut_Icon&quot;);" />
        <ui:Label name="Title" text="Donut" picking-mode="Ignore" style="color: rgb(206, 210, 217); font-size: 22px; -unity-text-align: middle-center; white-space: normal; -unity-font-definition: url(&quot;project://database/Assets/Fonts/IBMPlexMono-Bold.ttf?fileID=12800000&amp;guid=13cf4c528592c284ba9157284e547e8b&amp;type=3#IBMPlexMono-Bold&quot;);" />
        <ui:Label name="Amount" text="5" picking-mode="Ignore" style="position: absolute; top: 2px; right: 6px; color: rgb(214, 173, 70); font-size: 22px; -unity-font-style: bold; -unity-font-definition: url(&quot;project://database/Assets/Fonts/IBMPlexMono-BoldItalic.ttf?fileID=12800000&amp;guid=3c9174fb94f319843be12af5d4422863&amp;type=3#IBMPlexMono-BoldItalic&quot;);" />
    </ui:VisualElement>
</ui:UXML>
