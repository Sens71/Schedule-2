  m_Script: {fileID: 11500000, guid: 079b88322ef30e44688176a35eb4e791, type: 3}
  m_Name: MessageData
  m_EditorClassIdentifier: 
  preview: It's me again. Need the usual {item} for the weekend...
  introduction: "Yo, don\u2019t leave me hanging. Got people showing up in an hour
    and the stash is looking empty. Need {amount} of {item} like yesterday. I\u2019ve
    got {price} on me, just say when and where. You good to come through?"
  acceptTask: Cool. Same spot as last time? Just put it there and send the coordinates.
    I'll grab it later.
  rejectTask: Wait, what? Come on man, it's me. You sure? ...Alright, hit me up if
    you change your mind.
  bargainPositive: For you? Alright, {bargain}. But next time give me better price,
    yeah? We're cool. Send it.
  bargainNegative: Come on man, that's not cool. I thought we had a deal. Can't do
    {price}. Maybe another time.
  dealOverPositive: All good, brother. Came through as always. I'll hit you up next
    week.
  dealOverNegative: Bro... I waited. What happened? Thought we were good. This is
    disappointing. I'll find someone else for now.
