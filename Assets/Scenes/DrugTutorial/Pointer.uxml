<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement name="root" style="flex-grow: 0; justify-content: center; align-items: center; align-self: center; align-content: flex-start; flex-direction: column; position: absolute; top: 0; left: 0; right: 0; bottom: 0; background-color: rgb(34, 30, 42);">
        <ui:Label text="Pointer events&#10;" name="Label" style="flex-direction: column; flex-wrap: nowrap; font-size: 30px; -unity-font-style: bold; color: rgb(255, 255, 255);" />
        <ui:VisualElement name="Box" style="flex-grow: 0; background-color: rgb(60, 71, 180); background-size: 40% 40%; -unity-background-scale-mode: stretch-to-fill; width: 160px; height: 160px; align-items: auto; justify-content: flex-start; border-top-left-radius: 20px; border-top-right-radius: 20px; border-bottom-right-radius: 20px; border-bottom-left-radius: 20px; border-left-color: rgb(255, 199, 0); border-right-color: rgb(255, 199, 0); border-top-color: rgb(255, 199, 0); border-bottom-color: rgb(255, 199, 0); border-top-width: 5px; border-right-width: 5px; border-bottom-width: 5px; border-left-width: 5px;" />
        <ui:Label text="Label" name="Log" style="font-size: 25px; -unity-font-style: normal; color: rgb(255, 255, 255);" />
    </ui:VisualElement>
</ui:UXML>
