    <ui:VisualElement name="Ghost" style="flex-grow: 0; position: absolute; width: 100px; height: 100px; background-color: rgba(0, 0, 0, 0.49); align-items: center; justify-content: center; translate: -50% -50%; border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; border-top-left-radius: 10px; border-top-right-radius: 10px; border-bottom-right-radius: 10px; border-bottom-left-radius: 10px;">
        <ui:VisualElement name="Icon" style="flex-grow: 0; background-color: rgba(0, 0, 0, 0.15); width: 80px; height: 80px; border-top-width: 3px; border-right-width: 3px; border-bottom-width: 3px; border-left-width: 3px; border-top-left-radius: 4px; border-top-right-radius: 4px; border-bottom-right-radius: 4px; border-bottom-left-radius: 4px; border-left-color: rgba(255, 235, 4, 0.39); border-right-color: rgba(255, 235, 4, 0.39); border-top-color: rgba(255, 235, 4, 0.39); border-bottom-color: rgba(255, 235, 4, 0.39); top: auto; right: auto; bottom: auto; left: auto; background-image: none; -unity-background-image-tint-color: rgba(255, 255, 255, 0.59);" />
